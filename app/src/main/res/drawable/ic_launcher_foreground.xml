<?xml version="1.0" encoding="utf-8"?>
<!-- App icon foreground — a wallet (expense tracking) with an upward
     growth line breaking out of it (wealth tracking), reflecting the
     app's dual purpose. Kept within the ~66dp adaptive-icon safe zone
     (roughly x:21-87, y:21-87 on this 108x108 canvas) so nothing gets
     clipped by launcher mask shapes (circle, squircle, rounded square). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Wallet body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M24,48 a6,6 0 0 1 6,-6 h48 a6,6 0 0 1 6,6 v26 a6,6 0 0 1 -6,6 h-48 a6,6 0 0 1 -6,-6 z" />

    <!-- Wallet flap — a slightly deeper shade at the top of the body,
         reading as the fold of a bifold wallet -->
    <path
        android:fillColor="#E8E8E8"
        android:pathData="M24,48 a6,6 0 0 1 6,-6 h48 a6,6 0 0 1 6,6 v9 h-60 z" />

    <!-- Wallet clasp -->
    <path
        android:fillColor="#2E5E4E"
        android:pathData="M79,61 m-4,0 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0" />

    <!-- Growth line — a rising zigzag breaking out above the wallet -->
    <path
        android:strokeColor="#C87F3C"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M30,46 L42,32 L52,40 L68,23" />

    <!-- Arrowhead at the top of the growth line -->
    <path
        android:fillColor="#C87F3C"
        android:pathData="M68,23 L58,24 L67,32 Z" />

</vector>
